# Server-only. NOT NEXT_PUBLIC_ — the browser never sees this.
# Base URL of the n8n Cloud webhook, without a trailing slash.
# e.g. https://your-instance.app.n8n.cloud/webhook
# Leave unset to run the whole app on local mock data.
N8N_WEBHOOK_URL=

# Server-only, both of them. NOT NEXT_PUBLIC_.
# The third agent: a second opinion on an amended claim, from a different
# provider than the two Gemini agents. Optional — leave both unset and the
# deterministic re-check in lib/reaudit.ts is the whole control, which is how
# it is designed to work.
LYZR_API_KEY=
LYZR_AGENT_ID=
