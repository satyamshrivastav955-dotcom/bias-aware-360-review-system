{
  "name": "bias-aware-360-review-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:contracts && npm run test:evaluation",
    "test:unit": "tsx lib/stats.test.ts && tsx lib/sources.test.ts && tsx lib/n8n.test.ts && tsx lib/schemas.test.ts && tsx lib/reaudit.test.ts && tsx lib/consent.test.ts && tsx lib/retention.test.ts && tsx lib/reaudit-request.test.ts",
    "test:contracts": "tsx lib/contracts.test.ts",
    "test:evaluation": "tsx lib/evaluation.test.ts",
    "evaluation:report": "tsx -e \"import { evaluateCapturedReports } from './lib/evaluation'; console.log(JSON.stringify(evaluateCapturedReports(), null, 2))\"",
    "test:pipeline": "bash scripts/test_pipeline.sh",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
